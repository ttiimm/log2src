{
  "name": "log2src",
  "displayName": "log2src",
  "icon": "images/icon.png",
  "description": "Map runtime logs to source code for analysis and exploration.",
  "preview": true,
  "version": "0.2.0",
  "publisher": "log2src",
  "author": {
    "name": "Tim Likarish Ellis"
  },
  "license": "MIT",
  "keywords": [
    "debugger",
    "log",
    "logs",
    "dap",
    "source-mapping",
    "developer-tools"
  ],
  "engines": {
    "vscode": "^1.97.0",
    "node": ">=22.0.0",
    "pnpm": ">=10.8.0"
  },
  "categories": [
    "Debuggers"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ttiimm/log2src.git",
    "directory": "editors/code"
  },
  "bugs": {
    "url": "https://github.com/ttiimm/log2src/issues"
  },
  "activationEvents": [
    "onDebugResolve:log2src",
    "onLanguage:log2src"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "log2src",
        "extensions": [
          ".log",
          "*.log.?"
        ],
        "aliases": [
          "Log2Src"
        ]
      }
    ],
    "grammars": [
      {
        "language": "log2src",
        "scopeName": "text.log",
        "path": "./syntaxes/log2src.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "log2src"
      }
    ],
    "commands": [
      {
        "command": "log2src.configure",
        "title": "Log2Src: Configure Source Roots and Log Format"
      },
      {
        "command": "log2src.goToSourceAtCursor",
        "title": "Log2Src: Go to Source at Cursor"
      }
    ],
    "keybindings": [
      {
        "command": "log2src.goToSourceAtCursor",
        "key": "ctrl+alt+g",
        "mac": "cmd+alt+g",
        "when": "editorTextFocus && editorLangId == log2src"
      }
    ],
    "configuration": {
      "title": "Log2Src",
      "properties": {
        "log2src.sourceRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Absolute paths to source directories used to resolve log lines to source."
        },
        "log2src.logFormat": {
          "type": "string",
          "default": "",
          "description": "A regex with named captures (at least (?<body>...)) describing the log format."
        }
      }
    },
    "debuggers": [
      {
        "type": "log2src",
        "label": "log2src",
        "program": "./out/debugAdapter.js",
        "languages": [
          "log2src"
        ],
        "runtime": "node",
        "configurationAttributes": {
          "launch": {
            "required": [
              "source",
              "log"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Absolute path to a source directory."
              },
              "log": {
                "type": "string",
                "description": "Absolute path to a log file"
              },
              "log_format": {
                "type": "string",
                "description": "A regex that describes the log format"
              },
              "trace": {
                "type": "boolean",
                "description": "Enable log2src logging while running"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "log2src",
            "request": "launch",
            "name": "Launch: log2src",
            "source": "${workspaceFolder}/src/",
            "log": "${workspaceFolder}/log/*"
          }
        ],
        "configurationSnippets": [
          {
            "label": "log2src: Launch",
            "description": "The log2src run configuration for mapping logs to source files",
            "body": {
              "type": "log2src",
              "request": "launch",
              "name": "Launch: log2src",
              "source": "^\"\\${workspaceFolder}/...fillmein...\"",
              "log": "^\"\\${workspaceFolder}/log/*\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "pnpm run compile && pnpm run lint",
    "pretest:ci": "pnpm run pretest",
    "lint": "eslint src --ext ts",
    "test:unit": "mocha --ui tdd ./out/test/unit/**/*.test.js",
    "test:unit:grep": "mocha --ui tdd ./out/test/unit/**/*.test.js --grep \"$GREP\"",
    "test:ui": "node ./out/test/runTest.js",
    "test:ui:ci": "xvfb-run -a node ./out/test/runTest.js",
    "test": "pnpm run test:unit && pnpm run test:ui",
    "test:ci": "pnpm run test:unit && pnpm run test:ui:ci",
    "vscode:prepublish": "pnpm run esbuild-base --minify",
    "esbuild-base": "esbuild ./src/extension.ts ./src/debugAdapter.ts --bundle --outdir=out --external:vscode --format=cjs --platform=node",
    "esbuild": "pnpm run esbuild-base --sourcemap",
    "esbuild-watch": "pnpm run esbuild-base --sourcemap --watch"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.14.1",
    "@types/vscode": "^1.97.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vscode/debugadapter-testsupport": "^1.68.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "glob": "^11.1.0",
    "mocha": "^11.8.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0"
  }
}